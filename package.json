{
  "name": "futures",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:migrate": "cd packages/db && bunx prisma migrate deploy && bunx prisma generate",
    "engine:dev": "turbo run dev --filter=engine",
    "stack": "./scripts/dev.sh",
    "stack:prod": "./scripts/dev.sh --prod"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}

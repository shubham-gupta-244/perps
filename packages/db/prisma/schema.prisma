generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  wallet    Wallet?
  createdAt DateTime @default(now())

  @@map("users")
}

model Position {
  id               String    @id @default(uuid())
  userId           String    @unique
  size             Int       @default(0)
  entryPrice       Int       @default(0)
  margin           Int       @default(0)
  leverage         Int       @default(1)
  liquidationPrice Int       @default(0)
  realizedPnl      Int       @default(0)
  unrealizedPnl    Int       @default(0)
  markPrice        Int       @default(0)
  updatedAt        DateTime  @default(now()) @updatedAt
  wallet           Wallet    @relation(fields: [userId], references: [id])

  @@map("positions")
}

/** Idempotency ledger for at-least-once stream consumers (e.g. the db-poller). */
model ProcessedEvent {
  consumer  String
  eventId   String
  createdAt DateTime @default(now())

  @@id([consumer, eventId])
  @@map("processed_events")
}

/** Where a stream consumer's projection last got to (for observability / resume). */
model ConsumerCheckpoint {
  consumer    String   @id
  lastEventId String
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("consumer_checkpoints")
}

model Wallet {
  id            String     @id @default(uuid())
  userId        String     @unique
  balance       Int
  freeBalance   Int
  lockedBalance Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  orders        Order[]
  positions     Position[]
  Makerfills    Fills[]    @relation("makerUser")
  Takerfills    Fills[]    @relation("takerUser")
  user          User       @relation(fields: [userId], references: [id])

  @@map("wallet")
}

model Order {
  id               String    @id @default(uuid())
  walletId         String
  commandId        String?   @unique
  orderType        orderType
  side             side
  quantity         Int
  price            Int
  leverage         Int
  liquidationPrice Int
  lockedBalance    Int
  filledQuantity   Int       @default(0)
  avgFillPrice     Int       @default(0)
  status           status
  makerFills       Fills[]   @relation("makerFills")
  takerFills       Fills[]   @relation("takerFills")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  wallet           Wallet    @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@map("orders")
}

model Fills {
  id           String @id @default(uuid())
  tradeId      String @unique
  makerId      String
  takerId      String
  makerOrderId String
  takerOrderId String
  quantity     Int
  price        Int
  createdAt    DateTime @default(now())

  makerUser  Wallet @relation("makerUser", fields: [makerId], references: [id])
  takerUser  Wallet @relation("takerUser", fields: [takerId], references: [id])
  makerOrder Order  @relation("makerFills", fields: [makerOrderId], references: [id])
  takerOrder Order  @relation("takerFills", fields: [takerOrderId], references: [id])

  @@map("fills")
}

enum status {
  PENDING
  OPEN
  PARTIALLYFILLED
  FILLED
  CANCELLED
  REJECTED
  CLOSE
}

enum side {
  BID
  ASK
}

enum orderType {
  LIMIT
  MARKET
}

  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/events": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/redis-streams": "workspace:*"
  }
}
